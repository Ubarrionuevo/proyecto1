# Variables de entorno del proyecto.
# Copiar a .env.local y completar. .env.local NO se sube al repo.

# URL publica del sitio. Se usa como base del sitemap, canonical y Open Graph.
NEXT_PUBLIC_BASE_URL=https://www.laprincesacta.com.ar

# ID de Google Analytics 4. Si no esta definido, la analitica no se carga
# (src/components/Analytics.tsx). Registraria los clics a WhatsApp como
# evento `whatsapp_click`.
NEXT_PUBLIC_GA_ID=G-KESWRNLJ8Y

# Token de verificacion de Google Search Console (metodo etiqueta meta).
# Si no se define, se usa el token por defecto que ya esta en layout.tsx.
NEXT_PUBLIC_GSC_VERIFICATION=

# Credenciales de Google (OAuth). Solo para las rutas que usan la API de
# Google: nunca se exponen al cliente, no usar NEXT_PUBLIC_ con estos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
